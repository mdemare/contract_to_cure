{
  "name": "move_unknown_destination",
  "description": "Unknown city: game-logic error with success false",
  "save_before": "states/base.json",
  "request": {
    "method": "POST",
    "path": "/move",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "player_index": 0,
      "destination": "Atlantis"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "Unknown destination Atlantis"
    }
  },
  "save_after": "unchanged"
}

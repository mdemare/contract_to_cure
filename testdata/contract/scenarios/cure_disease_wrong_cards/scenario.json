{
  "name": "cure_disease_wrong_cards",
  "description": "Cards do not match the color",
  "save_before": "states/base.json",
  "request": {
    "method": "POST",
    "path": "/cure_disease",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "color": "blue",
      "card_names": [
        "Wuhan",
        "Beijing",
        "Shanghai",
        "Seoul"
      ]
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "All selected cards must be blue city cards"
    }
  },
  "save_after": "unchanged"
}

{
  "name": "action_card_airlift_missing_player",
  "description": "Airlift without player_index: 422 (cc-435)",
  "save_before": "states/event_cards.yaml",
  "request": {
    "method": "POST",
    "path": "/action_card",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "card": "Airlift",
      "city": "Paris"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "No player given for Airlift"
    }
  },
  "save_after": "unchanged"
}

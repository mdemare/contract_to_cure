{
  "name": "action_card_unknown",
  "description": "Unknown event card: 422 error",
  "save_before": "states/base.yaml",
  "request": {
    "method": "POST",
    "path": "/action_card",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "card": "Epidemic"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "Unknown action card: Epidemic"
    }
  },
  "save_after": "unchanged"
}

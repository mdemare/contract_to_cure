{
  "name": "move_pending_discard",
  "description": "Actions are blocked while a hand-limit discard is pending",
  "save_before": "states/pending_discard.yaml",
  "request": {
    "method": "POST",
    "path": "/move",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "player_index": 0,
      "destination": "Bangkok"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "No more actions allowed"
    }
  },
  "save_after": "unchanged"
}

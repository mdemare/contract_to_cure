{
  "name": "discard_cards_game_over",
  "description": "Game over",
  "save_before": "states/game_over_victory.yaml",
  "request": {
    "method": "POST",
    "path": "/discard_cards",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "player_index": 0,
      "card_names": [
        "Wuhan"
      ]
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "status": "error",
      "message": "The game is over"
    }
  },
  "save_after": "unchanged"
}

{
  "name": "restart_game_difficulty",
  "description": "New random game with a new difficulty (after.yaml depends on the Ruby RNG)",
  "save_before": "states/base.yaml",
  "request": {
    "method": "POST",
    "path": "/restart_game",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "difficulty_level": "introductory"
    }
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": true,
      "status": "success",
      "message": "Game restarted successfully"
    }
  },
  "save_after": "scenarios/restart_game_difficulty/after.yaml"
}

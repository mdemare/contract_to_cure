{
  "name": "action_card_forecast_blocked",
  "description": "Other event cards during Forecast: 422 error",
  "save_before": "states/forecast_active.json",
  "request": {
    "method": "POST",
    "path": "/action_card",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "card": "Airlift",
      "player_index": 0,
      "city": "Paris"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "Cannot perform action while Forecast is active. Please complete the Forecast action first."
    }
  },
  "save_after": "unchanged"
}

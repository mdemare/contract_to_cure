{
  "name": "share_knowledge_not_same_city",
  "description": "Players are in different cities",
  "save_before": "states/base.json",
  "request": {
    "method": "POST",
    "path": "/share_knowledge",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "giving_player_index": 0,
      "receiving_player_index": 2,
      "city_name": "Wuhan"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "Both players must be in the same city to share knowledge"
    }
  },
  "save_after": "unchanged"
}

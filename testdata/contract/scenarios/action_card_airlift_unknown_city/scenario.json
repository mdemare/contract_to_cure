{
  "name": "action_card_airlift_unknown_city",
  "description": "Airlift to an unknown city",
  "save_before": "states/event_cards.json",
  "request": {
    "method": "POST",
    "path": "/action_card",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "card": "Airlift",
      "player_index": 0,
      "city": "Atlantis"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "City 'Atlantis' does not exist"
    }
  },
  "save_after": "unchanged"
}

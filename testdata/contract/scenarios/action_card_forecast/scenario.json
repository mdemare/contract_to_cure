{
  "name": "action_card_forecast",
  "description": "Forecast, step 1: shows the top six cards of the infection draw pile, next card first",
  "save_before": "states/event_cards.yaml",
  "request": {
    "method": "POST",
    "path": "/action_card",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "card": "Forecast"
    }
  },
  "response": {
    "status": 200,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "status": "success",
      "type": "forecast_view",
      "message": "Choose the order for the infection cards",
      "cards": [
        {
          "name": "Stockholm",
          "color": "blue"
        },
        {
          "name": "Nairobi",
          "color": "yellow"
        },
        {
          "name": "Sao Paulo",
          "color": "yellow"
        },
        {
          "name": "Jakarta",
          "color": "red"
        },
        {
          "name": "Mumbai",
          "color": "black"
        },
        {
          "name": "Kabul",
          "color": "black"
        }
      ]
    }
  },
  "save_after": "scenarios/action_card_forecast/after.yaml"
}

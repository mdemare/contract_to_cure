{
  "name": "share_knowledge_with_self",
  "description": "Giver and receiver are the same player: 422 (cc-441)",
  "save_before": "states/base.json",
  "request": {
    "method": "POST",
    "path": "/share_knowledge",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "giving_player_index": 0,
      "receiving_player_index": 0,
      "city_name": "Wuhan"
    }
  },
  "response": {
    "status": 422,
    "content_type": "application/json; charset=utf-8",
    "body": {
      "success": false,
      "status": "error",
      "message": "A player cannot share knowledge with themselves"
    }
  },
  "save_after": "unchanged"
}

# Settings read by the Go server (./main). In staging and production the
# deploy scripts generate .env from Fleet's secrets (Q13-xx); docker compose
# passes it to the container as environment variables.

# development, test, staging or production. Unset means production.
# DEPLOYMENT_ENV=development

# Port inside the container (compose sets it; default 2583).
# PORT=2583

# Authentication (AUTH.md). JWT_SECRET is required outside development and
# test.
JWT_SECRET=your_jwt_secret_here
# AUTH_SERVICE_URL=https://auth.example.com
# SUBDOMAIN=contracttocure
# DOMAIN_NAME=example.com

# Optional: Skip authentication (SKIP_AUTH=true), or keep it on in development
# and test (REQUIRE_AUTH=true)
# SKIP_AUTH=true
# REQUIRE_AUTH=true

# Redis configuration (if different from default). Inside the container,
# a Redis server on the host is redis://host.docker.internal:6379.
# REDIS_URL=redis://localhost:6379
# REDIS_POOL_SIZE=5
# REDIS_POOL_TIMEOUT=5

# Browser error notifications are always logged to the console.
# Set your Sentry project's public DSN to also report them to Sentry.
# This value is exposed to the browser; do not use a Sentry auth token.
# SENTRY_DSN=https://public-key@your-ingest-host/project-id

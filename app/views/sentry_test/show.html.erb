<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <title>Sentry test</title>
</head>
<body>
  <main>
    <h1>Sentry configuration test</h1>
    <p>Use these controls to send one browser error and one Rails error to Sentry.</p>
    <button id="frontend-error" type="button">Simulate frontend error</button>
    <button id="backend-error" type="button">Simulate backend error</button>
    <p id="result" role="status"></p>
  </main>
  <script>
    document.getElementById('frontend-error').addEventListener('click', () => {
      throw new Error('Sentry frontend test error');
    });
    document.getElementById('backend-error').addEventListener('click', async () => {
      const response = await fetch('/test-sentry/backend-error', {
        method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
      });
      document.getElementById('result').textContent = `Backend test returned HTTP ${response.status}`;
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <title>Contract To Cure</title>
  <link rel="stylesheet" href="/css/buttons.css">
  <link rel="stylesheet" href="/css/card_animation.css">
  <link rel="stylesheet" href="/css/card_selection.css">
  <link rel="stylesheet" href="/css/current_player.css">
  <link rel="stylesheet" href="/css/game_over.css">
  <link rel="stylesheet" href="/css/interface.css">
  <link rel="stylesheet" href="/css/map.css">
  <link rel="stylesheet" href="/css/notification.css">
  <link rel="stylesheet" href="/css/player_cards.css">
  <link rel="stylesheet" href="/css/player_panel.css">
  <link rel="stylesheet" href="/css/share_knowledge.css">
  <link rel="stylesheet" href="/css/player_selection.css">
  <link rel="stylesheet" href="/css/menu.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Roboto+Slab:wght@400;700&display=swap" rel="stylesheet">
  <script type="module" src="/js/auth.js"></script>
  <script type="module" src="/js/action_buttons.js"></script>
  <script type="module" src="/js/constants.js"></script>
  <script type="module" src="/js/current_player.js"></script>
  <script type="module" src="/js/end_turn_events.js"></script>
  <script type="module" src="/js/events.js"></script>
  <script type="module" src="/js/game_state.js"></script>
  <script type="module" src="/js/game_over.js"></script>
  <script type="module" src="/js/map.js"></script>
  <script type="module" src="/js/player_actions.js"></script>
  <script type="module" src="/js/player_panel.js"></script>
  <script type="module" src="/js/scrolling.js"></script>
  <script type="module" src="/js/retrieve_card.js"></script>
  <script type="module" src="/js/menu.js"></script>
</head>
<body<%= Rails.env.production? ? " data-git-hash=\"#{File.read('.git/refs/heads/trunk').strip[0..5] rescue ''}\"".html_safe : '' %>>
  <div class="top-view">
    <div class="left-view">
      <div class="logo-container">
        <img src="/logo.svg" alt="Contract To Cure">
      </div>
      <aside class="game-status" aria-labelledby="game-status-heading">
        <section class="status-panel">
          <div class="status-heading">
            <h2 id="game-status-heading">Game status</h2>
            <span class="turn-context">Turn <strong id="turn-counter">1</strong></span>
          </div>

          <div class="status-metrics">
            <div id="actions-status" class="status-metric actions-status" data-risk="critical"
                 aria-label="0 of 4 actions remaining, critical">
              <div class="metric-heading">
                <span class="metric-label">Actions left</span>
                <span class="risk-label">Critical</span>
              </div>
              <div class="metric-value"><strong id="action-counter">0</strong><span> / 4</span></div>
              <div class="action-pips" aria-hidden="true">
                <span class="action-pip"></span>
                <span class="action-pip"></span>
                <span class="action-pip"></span>
                <span class="action-pip"></span>
              </div>
            </div>

            <div id="outbreak-status" class="status-metric outbreak-status" data-risk="normal"
                 aria-label="0 of 8 outbreaks, stable">
              <div class="metric-heading">
                <span class="metric-label">Outbreaks</span>
                <span class="risk-label">Stable</span>
              </div>
              <div class="metric-value"><strong id="outbreak-counter">0</strong><span> / 8</span></div>
              <div id="outbreak-meter" class="status-meter" role="progressbar"
                   aria-label="0 of 8 outbreaks" aria-valuemin="0" aria-valuemax="8" aria-valuenow="0">
                <span class="status-meter-fill"></span>
              </div>
            </div>
          </div>

          <dl class="status-context">
            <div>
              <dt>Phase</dt>
              <dd id="phase-status">Player actions</dd>
            </div>
            <div>
              <dt>Player deck</dt>
              <dd><strong id="player-cards">35</strong> cards</dd>
            </div>
          </dl>
        </section>

        <section class="cure-status" aria-labelledby="disease-status-heading">
          <h2 id="disease-status-heading">Disease supply</h2>
          <div class="cure-grid">
            <% %w[blue yellow black red].each do |color| %>
              <article class="cure-item <%= color %>" data-risk="normal" aria-labelledby="<%= color %>-disease-name">
                <div class="cure-info">
                  <span class="cure-color" aria-hidden="true"></span>
                  <strong id="<%= color %>-disease-name" class="disease-name"><%= color.capitalize %></strong>
                  <span id="<%= color %>-cure" class="cure-label">Not cured</span>
                </div>
                <div class="cube-supply">
                  <span id="<%= color %>-cubes" class="cube-count">24 of 24 cubes</span>
                  <span class="supply-warning" aria-hidden="true"></span>
                </div>
                <div id="<%= color %>-cube-meter" class="cube-meter" role="progressbar"
                     aria-label="24 of 24 <%= color %> disease cubes remaining"
                     aria-valuemin="0" aria-valuemax="24" aria-valuenow="24">
                  <span class="cube-meter-fill"></span>
                </div>
              </article>
            <% end %>
          </div>
        </section>
      </aside>
    </div>
    <div class="right-view">
      <div class="game-header">
        <div class="menu-container">
          <button id="menu-toggle" class="menu-toggle" aria-label="Menu" aria-expanded="false">
            <div class="menu-icon">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span>Menu</span>
          </button>
          <div id="dropdown-menu" class="dropdown-menu" role="menu">
            <div id="auth-info-menu" class="user-info" style="display: none;">
              <span class="user-name-menu"></span>
              <span class="user-email"></span>
            </div>
            <button id="new-game-btn" class="menu-item" role="menuitem">
              <span>New Game</span>
            </button>
            <div class="menu-divider"></div>
            <button id="login-menu-btn" class="menu-item" role="menuitem" style="display: none;">
              <span>Login</span>
            </button>
            <button id="logout-menu-btn" class="menu-item" role="menuitem" style="display: none;">
              <span>Logout</span>
            </button>
          </div>
        </div>
      </div>
      <div class="map-wrapper">
        <div class="map-container">
          <svg class="connections-layer" width="100%" height="100%"></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Touch-Friendly Action Buttons -->
  <div class="action-buttons" data-phase="player_actions">
    <div class="current-player">
      <div class="current-player-pawn" id="current-player-pawn"></div>
      <div class="current-player-label" id="current-player-label">Current Player</div>
    </div>
    <div class="phase-actions" aria-label="Available actions">
      <button id="move-btn" class="action-btn move">
        <i></i>
        <span>Move</span>
      </button>
      <button id="treat-btn" class="action-btn treat">
        <i></i>
        <span>Treat</span>
      </button>
      <button id="share-btn" class="action-btn share">
        <i></i>
        <span>Share</span>
      </button>
      <button id="cure-btn" class="action-btn cure">
        <i></i>
        <span>Cure</span>
      </button>
      <button id="build-btn" class="action-btn build">
        <i></i>
        <span>Build</span>
      </button>
      <button id="retrieve-btn" class="action-btn retrieve">
        <i></i>
        <span>Retrieve</span>
      </button>
      <button id="pass-btn" class="action-btn pass">
        <i></i>
        <span>Pass</span>
      </button>
      <button id="infect-cities-btn" class="action-btn infect-cities" style="display: none">
        <i></i>
        <span>Infect Cities</span>
      </button>
      <button id="draw-cards-btn" class="action-btn draw-cards" style="display: none">
        <i></i>
        <span>Draw Cards</span>
      </button>
    </div>
    <div class="player-hand-container">
      <div class="player-hand-heading" aria-hidden="true">
        <span>Hand</span>
        <span id="active-hand-count">0 cards</span>
      </div>
      <div class="player-hand" aria-label="Current player's hand">
        <!-- Cards will be dynamically added here -->
      </div>
    </div>
  </div>
</body>
</html>
